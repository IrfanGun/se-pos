<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="~/logo.png" />
    <title>@ViewData["Title"] · MyPOS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyPOSApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/buttons.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar" id="mainSidebar">
            <a class="brand" asp-controller="Dashboard" asp-action="Index" aria-label="MyPOS, dashboard"><img class="brand-logo" src="~/logo.png" alt="" /></a>
            <nav class="side-nav" aria-label="Navigasi utama">
                <span class="nav-label">MENU</span>
                <a class="side-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index" aria-current="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "page" : null)" title="Dashboard">
                    <span class="lucide-icon lucide-layout-dashboard" aria-hidden="true"></span>
                    <span class="nav-text">Dashboard</span>
                </a>
                <a class="side-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Products" ? "active" : "")" asp-controller="Products" asp-action="Index" aria-current="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Products" ? "page" : null)" title="Produk">
                    <span class="lucide-icon lucide-package" aria-hidden="true"></span>
                    <span class="nav-text">Produk</span>
                </a>
                @if (User.HasClaim("permission", MyPOSApp.AppPermissions.UsersRead))
                {
                    <a class="side-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Users" ? "active" : "")" asp-controller="Users" asp-action="Index" title="Administrasi user">
                        <span class="lucide-icon lucide-users" aria-hidden="true"></span>
                        <span class="nav-text">Administrasi user</span>
                    </a>
                }
            </nav>
            <div class="sidebar-status @(ViewBag.ApiUnavailable == true ? "status-offline" : "")" title="API @(ViewBag.ApiUnavailable == true ? "tidak terhubung" : "terhubung")">
                <span class="lucide-icon lucide-network" aria-hidden="true"></span>
                <span class="status-text"><strong>MyPOS API</strong><small>@(ViewBag.ApiUnavailable == true ? "Tidak terhubung" : "Terhubung")</small></span>
                <i aria-hidden="true"></i>
            </div>
        </aside>
        <main class="main-column">
            <header class="topbar">
                <div class="topbar-leading">
                    <button type="button" class="sidebar-toggle" id="sidebarToggle" aria-label="Ciutkan sidebar" aria-expanded="true" aria-controls="mainSidebar" title="Ciutkan sidebar">
                        <span id="sidebarToggleIcon" class="lucide-icon lucide-panel-left-close" aria-hidden="true"></span>
                    </button>
                    <span class="breadcrumb">MyPOS <span>/</span> @ViewData["Title"]</span>
                </div>
                <div class="topbar-actions"><span class="account-name" title="@User.Identity?.Name">@User.Identity?.Name</span><form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="logout-button"><span class="lucide-icon lucide-log-out" aria-hidden="true"></span><span>Keluar</span></button></form></div>
            </header>
            <div class="main-content">@RenderBody()</div>
        </main>
    </div>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
