@model MyPOSApp.Models.LoginViewModel
@{
    Layout = null;
    var returnUrl = ViewData["ReturnUrl"] as string;
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Masuk · MyPOS</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page">
    <main class="login-page-content">
        <a class="brand login-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">m</span><span>MyPOS</span></a>
        <section class="login-form-wrap">
            <h1>Masuk</h1>
            <p class="login-subtitle">Gunakan akun POS Anda untuk melanjutkan.</p>

            <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" method="post" class="login-form">
                <div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div>
                <label asp-for="Username">Email</label>
                <input asp-for="Username" type="email" autocomplete="username" placeholder="nama@bisnis.com" autofocus />
                <span asp-validation-for="Username" class="field-error"></span>

                <label asp-for="Password">Password</label>
                <input asp-for="Password" autocomplete="current-password" placeholder="Masukkan password" />
                <span asp-validation-for="Password" class="field-error"></span>

                <label class="remember-row"><input asp-for="RememberMe" /><span>Ingat saya di perangkat ini</span></label>
                <button class="primary-button" type="submit">Masuk</button>
            </form>
            <p class="login-help">Masalah saat masuk? Hubungi administrator toko.</p>
        </section>
        <footer class="login-footer">MyPOS · Sistem point of sale</footer>
    </main>
</body>
</html>
