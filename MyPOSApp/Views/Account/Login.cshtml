@model MyPOSApp.Models.LoginViewModel
@{
    Layout = null;
    var returnUrl = ViewData["ReturnUrl"] as string;
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="~/logo.png" />
    <title>Masuk · MyPOS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/buttons.css" asp-append-version="true" />
</head>
<body class="login-page">
    <main class="login-page-content">
        <a class="brand login-brand" asp-controller="Home" asp-action="Index" aria-label="MyPOS"><img class="brand-logo" src="~/logo.png" alt="" /></a>
        <section class="login-form-wrap">
            <h1 class="m-auto">Masuk</h1>

            <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" method="post" class="login-form">
                <div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div>
                <label asp-for="Username" class="form-label">Email</label>
                <input asp-for="Username" class="form-control" type="email" autocomplete="username" placeholder="nama@bisnis.com" autofocus />
                <span asp-validation-for="Username" class="field-error"></span>

                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Masukkan password" />
                <span asp-validation-for="Password" class="field-error"></span>

                <label class="remember-row"><input asp-for="RememberMe" class="form-check-input" /><span class="form-check-label">Ingat saya di perangkat ini</span></label>
                <button class="primary-button" type="submit">Masuk</button>
            </form>
        </section>
        <footer class="login-footer">MyPOS · Sistem point of sale</footer>
    </main>
</body>
</html>
