{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5142;Database=se_pos;Username=postgres;Password=1234"
  },
  "Rbac": {
    "ProtectedRole": "Administrator",
    "Permissions": [
      { "Name": "dashboard.read", "Description": "Melihat dashboard" },
      { "Name": "products.read", "Description": "Melihat produk" },
      { "Name": "products.write", "Description": "Mengelola produk" },
      { "Name": "users.read", "Description": "Melihat daftar user" },
      { "Name": "users.manage", "Description": "Mengelola user dan role" }
    ],
    "Roles": [
      { "Name": "Administrator", "Description": "Akses penuh ke seluruh sistem", "Permissions": ["dashboard.read", "products.read", "products.write", "users.read", "users.manage"] },
      { "Name": "Manager", "Description": "Mengelola operasional toko", "Permissions": ["dashboard.read", "products.read", "products.write", "users.read"] },
      { "Name": "Cashier", "Description": "Mengoperasikan POS dan melihat produk", "Permissions": ["dashboard.read", "products.read"] }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
